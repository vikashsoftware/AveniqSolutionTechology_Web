@{
    ViewData["Title"] = "Enquiry review";
    ViewData["Description"] = "Enquiry review \u2014 Aveniq software, enterprise services and hardware solutions.";
}
<section class="page-hero"><div class="container"><span class="eyebrow">Enquiry review</span><h1>Your project brief.</h1><p>Review or download the details you prepared. Nothing has been sent to Aveniq.</p></div></section><section class="section"><div class="container"><div class="review-card"><p id="empty">Prepare your brief on the Contact Us page to see it here.</p><dl id="details"></dl><div class="actions"><button type="button" class="button" id="download" hidden style="border:0;font:inherit;cursor:pointer">Download brief</button><a class="button outline" href="/contact">Return to Contact Us</a></div></div></div></section><script>let data=null;try{data=JSON.parse(sessionStorage.getItem('aveniqEnquiry'))}catch(e){}if(data){document.getElementById('empty').textContent='Your brief is ready to download. Enquiry delivery is not configured yet.';const labels={person:'Name',company:'Company',email:'Email',interest:'Service',message:'Project details'};for(const [key,label] of Object.entries(labels)){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=label;dd.textContent=data[key]||'Not provided';document.getElementById('details').append(dt,dd)}const btn=document.getElementById('download');btn.hidden=false;btn.addEventListener('click',()=>{const text='Aveniq — Project enquiry\n\n'+Object.entries(labels).map(([key,label])=>label+': '+(data[key]||'Not provided')).join('\n\n');const url=URL.createObjectURL(new Blob([text],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='Aveniq_Project_Enquiry.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)})}</script>