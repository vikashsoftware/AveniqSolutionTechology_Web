@{
    ViewData["Title"] = "Contact Us";
    ViewData["Description"] = "Contact Us \u2014 Aveniq software, enterprise services and hardware solutions.";
}
<section class="page-hero"><div class="container"><span class="eyebrow">Contact Us</span><h1>What would you like to build or improve?</h1><p>Share your goals, current challenges, and any timeline you have in mind. A few details are enough to start shaping the conversation.</p></div></section><section class="section"><div class="container contact-grid"><div><div class="contact-panel"><span class="eyebrow">Your next step</span><h2>Start with a clear brief.</h2><p>You do not need a complete specification. Tell us about the outcome you want and the systems or processes involved.</p><ul class="checklist"><li style="color:#d9e8f0">What problem are you solving?</li><li style="color:#d9e8f0">Who will use the solution?</li><li style="color:#d9e8f0">What timeline or constraints matter?</li></ul><p class="note" style="color:#bad1df!important">Enquiry delivery will be available once the company contact details are configured. You can prepare and download your brief below.</p></div></div><form class="form" id="enquiry"><h2 style="margin:0;font-size:27px">Prepare your enquiry</h2><div class="field-row"><label>Your name<input name="person" autocomplete="name" required maxlength="100"></label><label>Company<input name="company" autocomplete="organization" maxlength="150"></label></div><label>Email address<input type="email" name="email" autocomplete="email" required maxlength="160"></label><label>Service of interest<select name="interest"><option>Software development</option><option>Technology solutions</option><option>Application support</option><option>Hardware supply</option><option>Cloud and infrastructure</option><option>Data and analytics</option><option>Enterprise services</option><option>Not sure yet</option></select></label><label>Project details<textarea name="message" required maxlength="3000" placeholder="Your goal, current challenge, and any important dates..."></textarea></label><button class="button" type="submit">Review your enquiry →</button><p class="form-status">This prepares a brief for you to review. It does not send a message.</p><a class="text-link" href="/privacy">How your enquiry details are handled →</a></form></div></section><script>document.getElementById('enquiry').addEventListener('submit',function(e){e.preventDefault();const data=Object.fromEntries(new FormData(e.currentTarget));try{sessionStorage.setItem('aveniqEnquiry',JSON.stringify(data));location.href='/enquiry'}catch(err){alert('Your browser could not store the enquiry. Please allow session storage and try again.')}})</script>